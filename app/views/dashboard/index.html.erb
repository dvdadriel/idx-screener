<%= turbo_stream_from "dashboard" %>

<%
  m         = @momentum
  risk_off  = m[:regime_today] != "risk_on"
  alpha     = m[:ihsg_return] ? (m[:total_return] - m[:ihsg_return]).round(2) : nil
  eligible  = @momentum_picks.first&.eligible_count
  # Hari risk-off direkam sebagai satu baris marker tanpa simbol, jadi "tidak ada
  # picks" TIDAK sama dengan "tidak ada snapshot". Membedakannya penting: yang
  # pertama adalah sistem bekerja dan memilih cash; yang kedua adalah pipeline mati.
  has_snapshot = m[:as_of].present?
%>

<%# === INSTRUMENT BAR ======================================================
    The regime gate decides whether the system may hold anything at all, so it
    is the first fact on the page and stays visible while the reader scrolls.
    Everything below is a reading taken under this condition. %>
<header class="bar">
  <div class="shell bar-row">
    <span class="wordmark">IDXSCREENER</span>

    <div class="bar-regime">
      <span class="t-xs ink-3">regime</span>
      <span class="chip <%= risk_off ? "fall" : "rise" %>">
        <span aria-hidden="true"><%= risk_off ? "■" : "▲" %></span>
        <%= risk_off ? "RISK-OFF" : "RISK-ON" %>
      </span>
      <span class="t-xs ink-3 truncate"><%= IdxMarketState.reason %></span>
    </div>

    <nav class="bar-nav">
      <%= link_to "Deep Scan", analysis_path, class: "nav-link" %>
      <%= link_to "Universe", idx_universe_path, class: "nav-link" %>
    </nav>
  </div>
</header>

<main class="main">
  <div class="shell stack">

    <%# === STATE RAIL =====================================================
        Five readings of one instrument state, divided by hairlines rather than
        boxed into cards — they are facets of a single measurement, not five
        independent objects. Each carries its own evidence status. %>
    <section aria-labelledby="state-h">
      <div class="band-head">
        <h2 id="state-h" class="band-title">Portfolio state</h2>
        <span class="band-meta">
          <% if m[:tracked_days].to_i.positive? %>
            <%= m[:inception] %> → <%= m[:as_of] %> · <%= m[:tracked_days] %> hari-snapshot
          <% else %>
            belum ada snapshot
          <% end %>
        </span>
      </div>

      <div class="rail">
        <div class="rail-cell">
          <div class="reading-label">Posisi</div>
          <div class="reading-value"><%= m[:holdings].any? ? "#{m[:holdings].size} nama" : "CASH" %></div>
          <div class="reading-note"><%= m[:holdings].any? ? "equal-weight" : "gate regime menahan entry" %></div>
        </div>

        <div class="rail-cell">
          <div class="reading-label">Return paper</div>
          <div class="reading-value <%= dir_class(m[:total_return]) %>"><%= signed_pct(m[:total_return]) %></div>
          <div class="reading-note evidence evidence-watch">◐ observasi · uang tidak nyata</div>
        </div>

        <div class="rail-cell">
          <div class="reading-label">Alpha vs IHSG</div>
          <div class="reading-value <%= dir_class(alpha) %>"><%= signed_pct(alpha) %></div>
          <div class="reading-note">IHSG <%= signed_pct(m[:ihsg_return]) %></div>
        </div>

        <div class="rail-cell">
          <div class="reading-label">Max drawdown</div>
          <div class="reading-value"><%= m[:max_drawdown].to_f.zero? ? "0,00%" : "−#{dec(m[:max_drawdown])}%" %></div>
          <div class="reading-note evidence evidence-proven">● kurva ekuitas harian</div>
        </div>

        <div class="rail-cell">
          <div class="reading-label">Aliran asing</div>
          <div class="reading-value ink-3">tak dipakai</div>
          <div class="reading-note evidence evidence-failed">○ gagal uji permutasi · p≈0,32</div>
        </div>
      </div>
    </section>

    <%# === RANKING ========================================================
        The product's core output. A table, not a card grid: the reader compares
        down a column, and right-aligned figures give the decimal points a
        vertical edge to scan. %>
    <section aria-labelledby="rank-h">
      <div class="band-head">
        <h2 id="rank-h" class="band-title">Peringkat momentum</h2>
        <span class="band-meta">
          <%= eligible ? "skor = persentil dari #{eligible} kandidat layak" : "6 bulan, lewati 1 bulan terakhir" %>
        </span>
      </div>

      <% if @momentum_picks.any? %>
        <% if risk_off %>
          <p class="note">
            <span class="fall">Watchlist.</span>
            Sistem tidak membeli saat regime risk-off — daftar ini untuk dipantau, bukan sinyal beli.
          </p>
        <% end %>

        <div class="scroll-x" style="margin-top:12px">
          <table class="itable">
            <caption class="sr-only">Peringkat momentum harian dengan skor persentil dan aliran dana asing</caption>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Saham</th>
                <th scope="col" class="num">Skor</th>
                <th scope="col" class="num">Momentum</th>
                <th scope="col" class="num">Harga</th>
                <th scope="col" class="num">Asing 20h</th>
                <th scope="col">Status bukti</th>
              </tr>
            </thead>
            <tbody>
              <% flows = IdxForeignFlowService.flow_ratios(@momentum_picks.map(&:symbol)) %>
              <% @momentum_picks.each do |p| %>
                <% mom  = (p.momentum.to_f * 100).round(1) %>
                <% flow = flows[p.symbol] %>
                <tr>
                  <td class="rank <%= "rank-lead" if p.rank == 1 %>"><%= format("%02d", p.rank) %></td>
                  <td class="sym"><%= p.symbol.sub(".JK", "") %></td>
                  <td class="num"><%= p.score || "—" %></td>
                  <td class="num <%= dir_class(mom) %>"><%= signed_pct(mom, decimals: 1) %></td>
                  <td class="num">Rp <%= num(p.price.to_f.round) %></td>
                  <td class="num <%= flow ? dir_class(flow) : "ink-3" %>">
                    <%= flow ? signed_pct(flow * 100, decimals: 1) : "—" %>
                  </td>
                  <td class="evidence evidence-watch">◐ observasi</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <p class="t-xs ink-3 measure" style="margin-top:12px">
          Skor menyatakan peringkat relatif hari ini, bukan prediksi harga.
          Kolom <span class="ink-2">Asing 20h</span> adalah net lembar asing dibagi volume 20 hari —
          ditampilkan sebagai informasi dan <span class="ink-2">tidak</span> ikut menentukan skor,
          karena overlay itu tak lolos uji permutasi terhadap subset acak berukuran sama.
        </p>
      <% elsif has_snapshot %>
        <div class="empty">
          <div class="empty-title">Cash — tidak ada peringkat yang direkam hari ini.</div>
          <p class="t-xs ink-3" style="margin-top:8px">
            Snapshot <span class="ink-2"><%= m[:as_of] %></span> tercatat sebagai hari risk-off:
            gate IHSG menahan entry, jadi tak ada top-10 yang dibeli maupun dipantau.
            Peringkat kembali muncul begitu regime berbalik risk-on.
          </p>
        </div>
      <% else %>
        <div class="empty">
          <div class="empty-title">Belum ada snapshot sama sekali.</div>
          <p class="t-xs ink-3" style="margin-top:8px">
            Rantai harian <span class="ink-2">idx:daily_close</span> merekam peringkat setiap hari bursa
            setelah candle 1d di-refresh. Baris pertama muncul setelah rantai itu berjalan sekali.
            Kalau baris ini bertahan lewat satu hari bursa, pipeline-nya yang bermasalah.
          </p>
        </div>
      <% end %>
    </section>

    <%= render "dashboard/paper_stats", stats: @stock_stats, open_trades: @stock_open_trades %>

    <%= render "dashboard/signals_table", signals: @stock_signals, dom_id: "stock_signals_body" %>

    <%# === COVERAGE =======================================================
        Not prices. What matters is whether the fetch reached every ticker — a
        gap is a data failure, and this block is shaped to reveal gaps. %>
    <% if @stock_candle_summary.any? %>
      <section aria-labelledby="uni-h">
        <div class="band-head">
          <h2 id="uni-h" class="band-title">Cakupan data</h2>
          <span class="band-meta">
            <%= num(@stock_candle_summary.size) %> / <%= num(@idx_universe_size) %>
            simbol punya candle 1d · bursa <%= @idx_open ? "buka" : "tutup" %>
          </span>
        </div>

        <div class="coverage">
          <% @stock_watchlist.each do |sym| %>
            <% c = @stock_candle_summary[sym] %>
            <% if c %>
              <span><%= sym.sub(".JK", "") %> <span class="ink-3 nums"><%= num(c.close.to_f.round) %></span></span>
            <% else %>
              <span class="coverage-miss" title="tidak ada candle 1d"><%= sym.sub(".JK", "") %></span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</main>

<footer class="foot">
  <div class="shell legend">
    <span>Paper trading — tidak pernah ada uang sungguhan di sini.</span>
    <span class="evidence evidence-proven">● tervalidasi</span>
    <span class="evidence evidence-watch">◐ observasi</span>
    <span class="evidence evidence-failed">○ gagal uji</span>
  </div>
</footer>
