<section aria-labelledby="signals-h">
  <div class="band-head">
    <h2 id="signals-h" class="band-title">Sinyal terkini</h2>
    <span class="band-meta"><%= signals.size %> terakhir · stream langsung</span>
  </div>

  <% if signals.any? %>
    <div class="scroll-x" style="margin-top:12px">
      <table class="itable">
        <caption class="sr-only">Sinyal trading terbaru</caption>
        <thead>
          <tr>
            <th scope="col">Saham</th>
            <th scope="col">Strategi</th>
            <th scope="col">Arah</th>
            <th scope="col" class="num">Skor</th>
            <th scope="col" class="num">SL / TP</th>
            <th scope="col" class="num">Waktu</th>
          </tr>
        </thead>
        <tbody id="<%= dom_id %>">
          <% signals.each { |signal| %><%= render "dashboard/signal_row", signal: signal %><% } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <div class="empty-title">Tidak ada sinyal.</div>
      <p class="t-xs ink-3" style="margin-top:8px">
        Diam adalah keadaan normal. Strategi per-trade sudah dihapus; yang tersisa adalah
        peringkat momentum harian, dan itu terbit sebagai snapshot — bukan sebagai sinyal
        yang menyala sepanjang hari.
      </p>
    </div>
  <% end %>
</section>
