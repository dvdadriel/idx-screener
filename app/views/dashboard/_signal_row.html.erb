<%
  meta   = signal.metadata || {}
  is_buy = signal.signal_type == "BUY"
  label  = signal.asset_type == "stock" ? signal.symbol.sub(".JK", "") : signal.symbol.sub("USDT", "")
  # Strategi yang sudah dihapus masih punya baris lama di tabel; tandai supaya
  # tak terbaca sebagai sesuatu yang masih hidup.
  retired = %w[CONFLUENCE SQUEEZE SWING_PICK MACD RSI BB_ VOLUME].any? { |r| signal.strategy.to_s.start_with?(r) }
%>
<tr id="<%= dom_id(signal) %>" class="trace-in">
  <td class="sym"><%= label %></td>

  <td class="<%= retired ? "ink-3" : "" %>">
    <%= signal.strategy %>
    <% if retired %><span class="evidence evidence-failed">○</span><% end %>
  </td>

  <%# Arah dibawa oleh glyph DAN kata, bukan warna saja — defisiensi merah-hijau
      paling umum dan di data finansial paling merugikan. %>
  <td class="<%= is_buy ? "rise" : "fall" %>">
    <span aria-hidden="true"><%= is_buy ? "▲" : "▼" %></span>
    <%= signal.signal_type %>
  </td>

  <td class="num"><%= signal.score_pct %></td>

  <td class="num">
    <% if meta["sl_pct"] && meta["tp_pct"] %>
      <span class="fall">−<%= dec(meta["sl_pct"].to_f.abs) %>%</span>
      <span class="ink-3">/</span>
      <span class="rise">+<%= dec(meta["tp_pct"].to_f.abs) %>%</span>
    <% else %>
      <span class="ink-3">—</span>
    <% end %>
  </td>

  <td class="num ink-3">
    <time datetime="<%= signal.fired_at.iso8601 %>" title="<%= signal.fired_at.in_time_zone(IdxMarket::TZ).strftime("%d %b %Y %H:%M") %>">
      <%= signal.fired_at.in_time_zone(IdxMarket::TZ).strftime("%d/%m %H:%M") %>
    </time>
  </td>
</tr>
