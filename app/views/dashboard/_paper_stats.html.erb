<%
  # Strategi yang sudah dihapus dari kode. Angkanya beku — dipertahankan di layar
  # karena alasan penghapusannya adalah bukti, dan bukti yang disembunyikan
  # cenderung diulang. Lihat docs/backtest-results.md.
  retired   = %w[CONFLUENCE SQUEEZE SWING_PICK MACD RSI BB_ VOLUME]
  retired_p = ->(name) { retired.any? { |r| name.to_s.start_with?(r) } }
  pf        = stats[:profit_factor]
%>

<section aria-labelledby="paper-h">
  <div class="band-head">
    <h2 id="paper-h" class="band-title">Bukti paper trading</h2>
    <span class="band-meta"><%= num(stats[:total_closed]) %> trade tertutup · <%= stats[:open_count] %> terbuka</span>
  </div>

  <div class="rail">
    <div class="rail-cell">
      <div class="reading-label">Profit factor</div>
      <div class="reading-value <%= pf.nil? ? "ink-3" : pf >= 1 ? "rise" : "fall" %>">
        <%= dec(pf) %>
      </div>
      <div class="reading-note">
        <%= pf && pf < 1 ? "kerugian melebihi keuntungan" : "gain ÷ loss" %>
      </div>
    </div>

    <div class="rail-cell">
      <div class="reading-label">Win rate</div>
      <div class="reading-value"><%= dec(stats[:win_rate]) %>%</div>
      <div class="reading-note">
        <span class="rise"><%= num(stats[:winners]) %> menang</span> ·
        <span class="fall"><%= num(stats[:losers]) %> kalah</span>
      </div>
    </div>

    <div class="rail-cell">
      <div class="reading-label">Rata-rata per trade</div>
      <div class="reading-value <%= dir_class(stats[:avg_pnl]) %>">
        <%= signed_pct(stats[:avg_pnl]) %>
      </div>
      <div class="reading-note">ekspektansi</div>
    </div>

    <div class="rail-cell">
      <div class="reading-label">Max drawdown</div>
      <div class="reading-value"><%= stats[:max_drawdown].nil? ? "—" : "−#{dec(stats[:max_drawdown])}%" %></div>
      <div class="reading-note evidence evidence-proven">● kurva harian, bukan jumlah pnl</div>
    </div>

    <div class="rail-cell">
      <div class="reading-label">Sharpe</div>
      <div class="reading-value <%= stats[:sharpe].nil? ? "ink-3" : dir_class(stats[:sharpe]) %>">
        <%= dec(stats[:sharpe]) %>
      </div>
      <div class="reading-note">per trade, tanpa anualisasi</div>
    </div>
  </div>

  <% if stats[:by_strategy].any? %>
    <div class="scroll-x" style="margin-top:24px">
      <table class="itable">
        <caption class="sr-only">Hasil paper trading per strategi, termasuk strategi yang sudah dipensiunkan</caption>
        <thead>
          <tr>
            <th scope="col">Strategi</th>
            <th scope="col" class="num">n</th>
            <th scope="col" class="num">Win rate</th>
            <th scope="col" class="num">Rata-rata</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% stats[:by_strategy].each do |s| %>
            <% gone = retired_p.(s[:strategy]) %>
            <tr>
              <td class="<%= gone ? "ink-3" : "sym" %>"><%= s[:strategy] %></td>
              <td class="num <%= "ink-3" if gone %>"><%= num(s[:total]) %></td>
              <td class="num <%= "ink-3" if gone %>"><%= dec(s[:win_rate]) %>%</td>
              <td class="num <%= gone ? "ink-3" : dir_class(s[:avg_pnl]) %>">
                <%= signed_pct(s[:avg_pnl]) %>
              </td>
              <td class="evidence <%= gone ? "evidence-failed" : "evidence-watch" %>">
                <%= gone ? "○ dihapus dari kode" : "◐ observasi" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="t-xs ink-3 measure" style="margin-top:12px">
      Baris bertanda <span class="evidence evidence-failed">○</span> adalah strategi yang sudah
      dihapus dari kode. Angkanya beku dan tidak akan bertambah — dipertahankan di sini karena
      alasan penghapusannya adalah bukti, dan bukti yang disembunyikan cenderung diulang.
    </p>
  <% end %>

  <% if open_trades.any? %>
    <div class="scroll-x" style="margin-top:24px">
      <table class="itable">
        <caption class="sr-only">Posisi paper yang masih terbuka</caption>
        <thead>
          <tr>
            <th scope="col">Terbuka</th>
            <th scope="col">Strategi</th>
            <th scope="col" class="num">Entry</th>
            <th scope="col" class="num">Sekarang</th>
            <th scope="col" class="num">P&amp;L</th>
            <th scope="col" class="num">Sejak</th>
          </tr>
        </thead>
        <tbody>
          <% open_trades.each do |t| %>
            <% pnl = t.current_pnl_pct&.to_f&.round(2) %>
            <tr>
              <td class="sym"><%= t.symbol.sub(".JK", "") %></td>
              <td class="ink-3"><%= t.strategy %></td>
              <td class="num"><%= num(t.entry_price.to_f.round(2)) %></td>
              <td class="num"><%= t.current_price ? num(t.current_price.to_f.round(2)) : "—" %></td>
              <td class="num <%= dir_class(pnl) %>"><%= signed_pct(pnl) %></td>
              <td class="num ink-3"><%= ago(t.entry_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
