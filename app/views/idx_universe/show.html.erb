<main class="main">
  <div class="shell stack">

    <div class="page-head">
      <h1 class="page-title">Universe</h1>
      <span class="page-sub">daftar saham yang diranking tiap hari bursa</span>
      <span class="page-back"><%= link_to "← Dashboard", root_path, class: "nav-link" %></span>
    </div>

    <% if notice %>
      <div class="flash flash-ok"><span class="flash-tag">Berhasil</span><span><%= notice %></span></div>
    <% end %>
    <% if alert %>
      <div class="flash flash-err"><span class="flash-tag">Gagal</span><span><%= alert %></span></div>
    <% end %>

    <%# Sumber universe adalah fakta operasional, bukan hiasan: kalau ia diam-diam
        jatuh ke fallback hardcode, peringkat hari itu dihitung dari daftar yang
        salah. Itu sebabnya sumber dan jumlahnya berdiri sebagai pembacaan. %>
    <section aria-labelledby="src-h">
      <div class="band-head">
        <h2 id="src-h" class="band-title">Sumber aktif</h2>
        <span class="band-meta">
          <% if @uploaded_at %>diunggah <%= ago(@uploaded_at) %><% end %>
        </span>
      </div>

      <div class="rail">
        <div class="rail-cell">
          <div class="reading-label">Sumber</div>
          <%
            source_label, source_note, source_status = case @source
            when :custom    then [ "Berkas manual", "storage/idx_universe.txt", "evidence-proven" ]
            when :idx_api   then [ "API resmi IDX", "diambil ulang tiap 05.00 WIB", "evidence-proven" ]
            when :hardcoded then [ "Fallback hardcode", "API IDX gagal — daftar mungkin usang", "evidence-failed" ]
            else                 [ "Tidak diketahui", "cache belum terisi", "evidence-watch" ]
            end
          %>
          <div class="reading-value"><%= source_label %></div>
          <div class="reading-note evidence <%= source_status %>">
            <%= source_status == "evidence-proven" ? "●" : source_status == "evidence-watch" ? "◐" : "○" %>
            <%= source_note %>
          </div>
        </div>

        <div class="rail-cell">
          <div class="reading-label">Jumlah ticker</div>
          <div class="reading-value"><%= num(@tickers.size) %></div>
          <div class="reading-note">masuk rotasi ranking</div>
        </div>

        <div class="rail-cell">
          <div class="reading-label">Tindakan</div>
          <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:6px">
            <%= link_to "Unduh .txt", download_idx_universe_path, class: "btn" %>
            <% if @source == :custom %>
              <%= button_to "Hapus daftar manual", idx_universe_path, method: :delete,
                    form: { data: { turbo_confirm: "Hapus daftar manual? Universe kembali ke API IDX." } },
                    class: "btn btn-danger" %>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="up-h">
      <div class="band-head">
        <h2 id="up-h" class="band-title">Unggah daftar sendiri</h2>
        <span class="band-meta">aktif segera · sufiks .JK ditambahkan otomatis</span>
      </div>

      <%= form_with url: idx_universe_path, method: :post, multipart: true, class: "measure", style: "margin-top:16px" do |f| %>
        <div>
          <%= f.label :file, "Berkas", class: "field-label" %>
          <%= f.file_field :file, accept: ".txt,.csv,.list", class: "field-file" %>
        </div>

        <hr class="hr">

        <div>
          <%= f.label :tickers, "Atau tempel langsung", class: "field-label" %>
          <%= f.text_area :tickers, rows: 6, class: "field",
                placeholder: "BBCA\nBBRI\nTLKM\n\natau: BBCA, BBRI, TLKM" %>
          <p class="field-hint">Satu ticker per baris, dipisah koma, atau dipisah spasi — ketiganya diterima.</p>
        </div>

        <div style="margin-top:16px">
          <%= f.submit "Unggah & aktifkan", class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>

    <section aria-labelledby="list-h">
      <div class="band-head">
        <h2 id="list-h" class="band-title">Isi universe</h2>
        <span class="band-meta">
          <%= @tickers.size > 100 ? "100 pertama dari #{num(@tickers.size)}" : "#{num(@tickers.size)} ticker" %>
        </span>
      </div>

      <div class="tokens" style="margin-top:12px">
        <% @tickers.first(100).each do |t| %>
          <span><%= t.sub(".JK", "") %></span>
        <% end %>
        <% if @tickers.size > 100 %>
          <span class="ink-3">+<%= num(@tickers.size - 100) %> lainnya</span>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="how-h">
      <div class="band-head">
        <h2 id="how-h" class="band-title">Cara kerjanya</h2>
      </div>
      <p class="t-xs ink-3" style="margin-top:12px">
        Sumber dipilih berurutan: berkas manual di <span class="ink-2">storage/idx_universe.txt</span>,
        lalu API resmi IDX (~900 emiten), lalu daftar hardcode sebagai jaring pengaman terakhir.
        Kalau baris sumber di atas menunjukkan <span class="ink-2">fallback hardcode</span>, API IDX
        sedang gagal dan universe hari itu mungkin sudah usang — peringkat tetap terbit, jadi ini
        satu-satunya tempat kegagalan itu terlihat.
      </p>
    </section>
  </div>
</main>
