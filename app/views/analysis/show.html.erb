<main class="main">
  <div class="shell stack">

    <div class="page-head">
      <h1 class="page-title">Deep Scan</h1>
      <span class="page-sub">pembacaan multi-timeframe untuk satu simbol</span>
      <span class="page-back"><%= link_to "← Dashboard", root_path, class: "nav-link" %></span>
    </div>

    <%= form_with url: analysis_path, method: :get, class: "measure" do |f| %>
      <%= f.label :symbol, "Simbol", class: "field-label" %>
      <div style="display:flex; gap:8px">
        <%= f.text_field :symbol, value: @symbol, autofocus: @symbol.blank?,
              placeholder: "BBCA · TLKM.JK · BTCUSDT", class: "field" %>
        <%= f.submit "Baca", class: "btn btn-primary" %>
      </div>
      <p class="field-hint">Format terdeteksi otomatis: <span class="ink-2">BBCA</span> → saham IDX, <span class="ink-2">BTC</span> → crypto.</p>
    <% end %>

    <% if @result.nil? %>
      <div class="empty">
        <div class="empty-title">Belum ada simbol yang dibaca.</div>
        <p class="t-xs ink-3" style="margin-top:8px">
          Halaman ini membaca indikator apa adanya di beberapa timeframe. Ia
          <span class="ink-2">tidak</span> memakai jalur momentum dan tidak menghasilkan sinyal
          yang tercatat — gunakan untuk memeriksa satu saham, bukan untuk mengambil keputusan.
        </p>
      </div>

    <% elsif @result[:error] %>
      <div class="flash flash-err"><span class="flash-tag">Gagal</span><span><%= @result[:error] %></span></div>

    <% else %>
      <% rec = @result[:recommendation] || {} %>
      <% stock = @result[:asset_type] == "stock" %>
      <% price = ->(v) { v.nil? ? "—" : stock ? "Rp #{num(v.to_f.round)}" : "$#{dec(v.to_f.round(4))}" } %>

      <%# Verdict sengaja BUKAN hero metric. Jalur confluence yang dulu memberi
          verdict "HIGH confidence" sudah dihapus karena rugi out-of-sample, jadi
          yang tersisa adalah agregasi deskriptif — dan ia harus terlihat seperti
          agregasi deskriptif, bukan seperti perintah. %>
      <section aria-labelledby="v-h">
        <div class="band-head">
          <h2 id="v-h" class="band-title"><%= @result[:display] %></h2>
          <span class="band-meta">
            <%= @result[:asset_type] %> · dibaca <%= ago(@result[:analyzed_at]) %>
          </span>
        </div>

        <div class="rail">
          <div class="rail-cell">
            <div class="reading-label">Pembacaan</div>
            <div class="verdict" style="margin-top:4px">
              <span class="verdict-word"><%= rec[:verdict] %></span>
              <span class="verdict-meta"><%= rec[:confidence] %></span>
            </div>
            <div class="reading-note evidence evidence-failed">○ agregasi indikator · tak tervalidasi</div>
          </div>

          <div class="rail-cell">
            <div class="reading-label">Alasan</div>
            <div class="t-xs ink-2" style="margin-top:6px"><%= rec[:reason] %></div>
          </div>

          <% if rec[:entry] %>
            <div class="rail-cell">
              <div class="reading-label">Entry</div>
              <div class="reading-value"><%= price.(rec[:entry]) %></div>
              <div class="reading-note">R:R 1:<%= dec(rec[:risk_reward]) %></div>
            </div>

            <div class="rail-cell">
              <div class="reading-label">Stop loss</div>
              <div class="reading-value fall"><%= price.(rec[:sl]) %></div>
              <div class="reading-note fall"><%= signed_pct(rec[:sl_pct]) %></div>
            </div>

            <div class="rail-cell">
              <div class="reading-label">Take profit</div>
              <div class="reading-value rise"><%= price.(rec[:tp]) %></div>
              <div class="reading-note rise"><%= signed_pct(rec[:tp_pct].to_f.abs) %></div>
            </div>
          <% end %>
        </div>

        <p class="t-xs ink-3 measure" style="margin-top:12px">
          <% if rec[:entry] %>
            Level di atas berasal dari ATR (SL 1,5× · TP 3×) — itu aturan ukuran posisi,
            bukan prediksi arah.
          <% end %>
          Pembacaan verdict-nya tidak pernah lolos validasi out-of-sample; jalur yang
          menghasilkannya sudah dihapus dari sistem sinyal. Pakai halaman ini untuk
          memeriksa, bukan untuk memutuskan.
        </p>
      </section>

      <% if @result[:narrative].present? %>
        <section aria-labelledby="n-h">
          <div class="band-head">
            <h2 id="n-h" class="band-title">Narasi model</h2>
            <span class="band-meta">dihasilkan LLM · tidak diverifikasi</span>
          </div>
          <p class="ink-2" style="margin-top:12px"><%= @result[:narrative] %></p>
        </section>
      <% end %>

      <section aria-labelledby="tf-h">
        <div class="band-head">
          <h2 id="tf-h" class="band-title">Per timeframe</h2>
          <span class="band-meta"><%= @result[:timeframes].count { |_, d| d[:has_data] } %> timeframe punya data</span>
        </div>

        <% @result[:timeframes].each do |tf, d| %>
          <% next unless d[:has_data] %>
          <div class="tf">
            <div class="tf-head">
              <span class="tf-name"><%= tf.upcase %></span>
              <span class="t-xs ink-3"><%= num(d[:candle_count]) %> candle</span>
              <span class="t-xs <%= d[:trend_bias] == :bullish ? "rise" : d[:trend_bias] == :bearish ? "fall" : "ink-3" %>">
                <span aria-hidden="true"><%= d[:trend_bias] == :bullish ? "▲" : d[:trend_bias] == :bearish ? "▼" : "■" %></span>
                <%= d[:trend_bias] %>
              </span>
              <span class="tf-price">
                <%= price.(d[:last_close]) %>
                <span class="<%= dir_class(d[:price_change]) %>"><%= signed_pct(d[:price_change]) %></span>
              </span>
            </div>

            <div class="kv">
              <div class="kv-item">
                <div class="kv-key">RSI 14</div>
                <div class="kv-val <%= d[:rsi].to_f < 30 ? "rise" : d[:rsi].to_f > 70 ? "fall" : "" %>"><%= dec(d[:rsi]) %></div>
                <% if d[:rsi_signal] %><div class="kv-note"><%= d[:rsi_signal][:reason] %></div><% end %>
              </div>

              <div class="kv-item">
                <div class="kv-key">MACD hist</div>
                <div class="kv-val <%= dir_class(d[:macd_hist]) %>">
                  <%= dec(d[:macd_hist]) %><span aria-hidden="true"><%= d[:macd_rising] ? " ↑" : " ↓" %></span>
                </div>
                <% if d[:macd_signal] %><div class="kv-note"><%= d[:macd_signal][:reason] %></div><% end %>
              </div>

              <div class="kv-item">
                <div class="kv-key">Bollinger</div>
                <div class="kv-val" style="font-size:13px"><%= d[:bb_position] %></div>
              </div>

              <div class="kv-item">
                <div class="kv-key">Volume</div>
                <div class="kv-val"><%= dec(d[:volume_ratio]) %>×</div>
                <div class="kv-note">vs rata-rata 20</div>
              </div>

              <% if d[:ema50] %>
                <div class="kv-item">
                  <div class="kv-key">vs EMA50</div>
                  <div class="kv-val <%= dir_class(d[:vs_ema50_pct]) %>"><%= signed_pct(d[:vs_ema50_pct]) %></div>
                </div>
              <% end %>

              <% if d[:ema200] %>
                <div class="kv-item">
                  <div class="kv-key">vs EMA200</div>
                  <div class="kv-val <%= dir_class(d[:vs_ema200_pct]) %>"><%= signed_pct(d[:vs_ema200_pct]) %></div>
                </div>
              <% end %>

              <div class="kv-item">
                <div class="kv-key">ATR</div>
                <div class="kv-val"><%= dec(d[:atr_pct]) %>%</div>
                <div class="kv-note">volatilitas harian</div>
              </div>
            </div>
          </div>
        <% end %>
      </section>

      <% if @result[:recent_signals].any? %>
        <section aria-labelledby="sig-h">
          <div class="band-head">
            <h2 id="sig-h" class="band-title">Sinyal tercatat</h2>
            <span class="band-meta">riwayat, bukan sinyal aktif</span>
          </div>

          <div class="scroll-x" style="margin-top:12px">
            <table class="itable">
              <caption class="sr-only">Sinyal yang pernah tercatat untuk simbol ini</caption>
              <thead>
                <tr>
                  <th scope="col">Arah</th>
                  <th scope="col">Strategi</th>
                  <th scope="col" class="num">Skor</th>
                  <th scope="col" class="num">Waktu</th>
                </tr>
              </thead>
              <tbody>
                <% @result[:recent_signals].each do |s| %>
                  <% buy = s.signal_type == "BUY" %>
                  <tr>
                    <td class="<%= buy ? "rise" : "fall" %>">
                      <span aria-hidden="true"><%= buy ? "▲" : "▼" %></span> <%= s.signal_type %>
                    </td>
                    <td class="ink-3"><%= s.strategy %></td>
                    <td class="num"><%= s.score_pct %></td>
                    <td class="num ink-3"><%= s.fired_at.in_time_zone(IdxMarket::TZ).strftime("%d/%m %H:%M") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% pt = @result[:paper_trades] %>
      <% if pt[:closed].any? || pt[:open].any? %>
        <section aria-labelledby="pt-h">
          <div class="band-head">
            <h2 id="pt-h" class="band-title">Riwayat paper</h2>
            <span class="band-meta">
              <% if pt[:win_rate] %>WR <%= dec(pt[:win_rate]) %>% · rata-rata <%= signed_pct(pt[:avg_pnl]) %><% end %>
            </span>
          </div>

          <div class="scroll-x" style="margin-top:12px">
            <table class="itable">
              <caption class="sr-only">Paper trade untuk simbol ini</caption>
              <thead>
                <tr>
                  <th scope="col">Sisi</th>
                  <th scope="col">Strategi</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="num">P&amp;L</th>
                  <th scope="col" class="num">Masuk</th>
                </tr>
              </thead>
              <tbody>
                <% (pt[:open].to_a + pt[:closed].to_a).first(10).each do |t| %>
                  <% pnl = (t.closed? ? t.pnl_pct : t.current_pnl_pct)&.to_f&.round(2) %>
                  <tr>
                    <td class="<%= t.side == "BUY" ? "rise" : "fall" %>">
                      <span aria-hidden="true"><%= t.side == "BUY" ? "▲" : "▼" %></span> <%= t.side %>
                    </td>
                    <td class="ink-3"><%= t.strategy %></td>
                    <td class="ink-3"><%= t.status %></td>
                    <td class="num <%= dir_class(pnl) %>"><%= signed_pct(pnl) %></td>
                    <td class="num ink-3"><%= t.entry_at.in_time_zone(IdxMarket::TZ).strftime("%d/%m") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    <% end %>
  </div>
</main>
